PORT=4000
DATABASE_URL=postgres://postgres:almagest@localhost:5432/almagest_prod
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=almagest_prod
# Cloud (Render): set TRUST_PROXY=1, AUTO_SETUP=1, NODE_ENV=production, and use Neon / Atlas URLs for DATABASE_URL / MONGODB_URI
TRUST_PROXY=
AUTO_SETUP=
