{
  "name": "almagest",
  "version": "1.0.0",
  "description": "Almagest: astronomy enthusiasts portal with a learning session recommender",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup": "node db/setup.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "test": "NODE_ENV=test MONGODB_DB=almagest_test DATABASE_URL=postgres://postgres:almagest@localhost:5432/almagest_test node --test test/*.test.js",
    "simulate": "node scripts/simulate.js",
    "migrate:mongo": "node scripts/migrate-to-mongo.js"
  },
  "license": "MIT",
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.7.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.30.0"
  }
}